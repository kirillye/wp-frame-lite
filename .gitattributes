# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.br binary
*.gz binary

# Сборка и конвертация — генерируются, диффы в них смотреть незачем
assets/dist/** linguist-generated=true
assets/webp/** linguist-generated=true
