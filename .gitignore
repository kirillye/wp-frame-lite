# Dependencies
node_modules/

# Build output
# assets/dist/ намеренно КОММИТИТСЯ. Тема уезжает на шаред-хостинг, где Node
# никто не запускает: без собранных файлов она осталась бы без стилей и скриптов.
# Пересобирать перед коммитом — `npm run build`.
# Карты исходников нужны только локально.
assets/dist/**/*.map

# Composer
vendor/

# OS
.DS_Store
Thumbs.db

# IDE & Claude Code
# Настройки форматирования коммитим — они часть тулинга темы.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.claude/

# WordPress
*.log
style.css.map
